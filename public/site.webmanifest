{
  "id": "/",
  "name": "LL PDF",
  "short_name": "LL PDF",
  "description": "Free PDF editor and e-signing from Limestone Labs. Edits happen on your device; files are not uploaded.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14141a",
  "theme_color": "#14141a",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"}
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {"application/pdf": [".pdf"]},
      "icons": [
        {"src": "file-icon-256.png", "sizes": "256x256", "type": "image/png"},
        {"src": "file-icon-48.png", "sizes": "48x48", "type": "image/png"},
        {"src": "file-icon-32.png", "sizes": "32x32", "type": "image/png"},
        {"src": "file-icon-16.png", "sizes": "16x16", "type": "image/png"}
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "file", "accept": ["application/pdf", ".pdf"]}]}
  }
}
